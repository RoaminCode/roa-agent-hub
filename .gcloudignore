# Everything git ignores stays out of deploys too (raw Roamer data in data/, local
# exports, screenshots, review output). Without this line gcloud ignores .gitignore.
#!include:.gitignore
.git/
.gitignore
.gitattributes
.gcloudignore
test/
scripts/
*.md

# Avatar source files; only assets/avatar-256.png is served.
assets/basecamp_avatar.png
assets/basecamp-avatar 1.png
